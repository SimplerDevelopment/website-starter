# CMS API URL — the main SimplerDevelopment platform URL
CMS_API_URL=https://simplerdevelopment.com

# Site ID — set automatically during provisioning
SITE_ID=

# API key (sd_live_…) from the portal, Settings → API Keys.
# Required: every v1 endpoint rejects unkeyed requests, branding and
# navigation included.
SD_API_KEY=

# Absolute origin for sitemap.xml and robots.txt.
# Falls back to the Vercel deployment URL, then http://localhost:3000.
SITE_URL=
